# Admin console environment
# Copy to .env.local for local development.

# Browser calls stay same-origin; Next proxies them to the private API locally
# and Nginx proxies them in production.
NEXT_PUBLIC_API_URL=/
API_INTERNAL_URL=http://localhost:3101
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Keep 0 for plain HTTP access. Set to 1 only behind HTTPS.
CSP_UPGRADE_INSECURE_REQUESTS=0

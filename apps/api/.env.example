# ── Venue On My Plate API ────────────────────────────────────────────────
# Copy this file to `.env` and adjust for your machine / deployment.

NODE_ENV=development
PORT=8081
HOST=0.0.0.0
APP_VERSION=1.0.0

# Public URLs (no trailing slash)
API_PUBLIC_URL=http://localhost:8081
FRONTEND_URL=http://localhost:3001
ADMIN_URL=http://localhost:3002

# Comma-separated list of browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Leave blank for the recommended same-origin /api setup, including the dev
# split-host deployment. Set a shared parent domain only if the admin browser
# calls a separate API origin directly and must share that cookie.
COOKIE_DOMAIN=
SESSION_HOURS=12

# SQLite database + uploads (relative to the api/ folder unless absolute)
DB_PATH=./data/vomp.sqlite
UPLOADS_DIR=./uploads
MAX_UPLOAD_MB=8
MAX_VIDEO_MB=80

# First-run admin account. Change immediately after first login.
SEED_ADMIN_NAME=Adarsh Sharma
SEED_ADMIN_EMAIL=admin@venueonmyplate.in
SEED_ADMIN_PASSWORD=change-me-before-first-run

# Trusted proxy hops (1 when Nginx sits in front of the API)
TRUST_PROXY=0

NODE_ENV=production
PORT=8081
HOST=127.0.0.1
APP_VERSION=1.0.0

API_PUBLIC_URL=https://admin.venueonmyplate.in
FRONTEND_URL=https://venueonmyplate.in
ADMIN_URL=https://admin.venueonmyplate.in

CORS_ORIGINS=https://venueonmyplate.in,https://www.venueonmyplate.in,https://admin.venueonmyplate.in

# Host-only cookie: the browser reaches /api through the admin domain.
COOKIE_DOMAIN=
SESSION_HOURS=12

DB_PATH=/var/www/vomp/shared/data/vomp.sqlite
UPLOADS_DIR=/var/www/vomp/shared/uploads
MAX_UPLOAD_MB=8
MAX_VIDEO_MB=80

SEED_ADMIN_NAME=Workspace Admin
SEED_ADMIN_EMAIL=admin@venueonmyplate.in
SEED_ADMIN_PASSWORD=replace-with-a-strong-password

# One Nginx proxy in front of the API.
TRUST_PROXY=1

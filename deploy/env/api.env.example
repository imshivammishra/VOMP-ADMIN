# Rendered by deploy/scripts/init-env.sh. Do not copy this file by hand.
NODE_ENV=production
PORT=3101
HOST=127.0.0.1
APP_VERSION=1.0.0

API_PUBLIC_URL=__API_ORIGIN__
FRONTEND_URL=__FRONTEND_ORIGIN__
ADMIN_URL=__ADMIN_ORIGIN__

CORS_ORIGINS=__CORS_ORIGINS__

# Host-only cookie: browsers reach /api through the website/admin origin.
COOKIE_DOMAIN=
# true behind HTTPS (recommended). Set false only for temporary HTTP/IP access.
COOKIE_SECURE=__COOKIE_SECURE__
SESSION_HOURS=12

DB_PATH=__DB_PATH__
UPLOADS_DIR=__UPLOADS_DIR__
MAX_UPLOAD_MB=8
MAX_VIDEO_MB=80

SEED_ADMIN_NAME=Workspace Admin
SEED_ADMIN_EMAIL=__SEED_ADMIN_EMAIL__
SEED_ADMIN_PASSWORD=replace-with-a-strong-password

# 1 when Nginx is the only public entry point; 0 for direct IP:port access.
TRUST_PROXY=__TRUST_PROXY__

# Tested PM2 7 boot unit for the current Contabo VPS.
#
# PM2 7 does not create the PIDFile expected by the unit generated by
# `pm2 startup`, which makes systemd report `Result: protocol`. This unit uses
# Type=oneshot + RemainAfterExit instead.
#
# Install:
#   sudo cp deploy/pm2/pm2-adarsharma.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now pm2-adarsharma
#
# Adjust the Node version in PATH/ExecStart if nvm moves to a new version.
[Unit]
Description=PM2 process manager for VOMP
Documentation=https://pm2.keymetrics.io/
After=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=adarsharma
LimitNOFILE=infinity
LimitNPROC=infinity
LimitCORE=infinity
Environment=PATH=/home/adarsharma/.nvm/versions/node/v22.23.2/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PM2_HOME=/home/adarsharma/.pm2
WorkingDirectory=/opt/vomp-deploy
ExecStart=/home/adarsharma/.nvm/versions/node/v22.23.2/lib/node_modules/pm2/bin/pm2 resurrect
ExecReload=/home/adarsharma/.nvm/versions/node/v22.23.2/lib/node_modules/pm2/bin/pm2 reload all
ExecStop=/home/adarsharma/.nvm/versions/node/v22.23.2/lib/node_modules/pm2/bin/pm2 kill
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target

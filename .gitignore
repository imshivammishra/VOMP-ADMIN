# Dependencies and build output
node_modules/
.next/
out/
dist/
*.tsbuildinfo

# Environment and secrets
.env
.env.local
.env.*.local
!**/.env.example

# Runtime data and media (kept on the server / locally, never in Git)
apps/api/data/*.sqlite
apps/api/data/*.sqlite-*
apps/api/uploads/*
!apps/api/data/.gitkeep
!apps/api/uploads/.gitkeep
apps/api/uploads/library/*

# Logs and editor noise
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Test and tooling caches
coverage/
playwright-report/
test-results/
